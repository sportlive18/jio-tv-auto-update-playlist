<article class="l-narrow-content">
	<p>
	You clicked on a preview of <b>http://tiny.cc/Pocket-TV</b>
	</p>

	Target URL:
	<textarea class="copy" style="width:100%;height:85px;border: 1px #d1d1d1 solid;">https://tamil-m3u-b58859.gitlab.io/</textarea><br /><br />

			
		<button id="countdown" type="button" class="button counter" onclick="return false;" disabled>Wait <span id="timer">5</span> to continue...</button>
		
		<script>
		var tinycc_timer = 5;
		var countdown_element, timer_element, countdown_handle;

		window.addEventListener('load', function(){
			countdown_element = document.getElementById("countdown");
			timer_element = document.getElementById("timer");

			countdown_handle = window.setInterval(function(){
				tinycc_timer--;
				if(tinycc_timer==0){
					countdown_element.innerHTML = "Go to this page";
					countdown_element.disabled = false;
					countdown_element.onclick = null;
					countdown_element.addEventListener('click', function(){
						window.open("https:\/\/tamil-m3u-b58859.gitlab.io\/");
					});
					countdown_element.classList.remove('counter');
					window.clearInterval(countdown_handle);
				}else{
					timer_element.innerHTML = tinycc_timer;
				}
			},1000);
		});
		</script>		
		<style>
			#countdown.counter{
				cursor:wait;
			}
		</style>
		
	<p>
		Due to abuse, full redirects are limited with trial accounts.<br>
		<a href="/tiny/contact" target="_blank">Contact support</a> and request to have this message removed.<br>
		Or activate a subscription to increase your redirect limit.
	</p>
