<style>#main-nav{background-color:#fff;color:#333333;position:sticky;top:0;z-index:10;display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:0 .5em}#main-nav > *{flex:1 1 auto}#home-link{transition:300ms transform;max-width:100px;height:auto}#home-link:hover{transform:scale(1.05)}#main-menu-checkbox{display:inline-block;width:0;height:0;opacity:0;flex:0 0 0}#main-menu{background-color:#fff;text-transform:uppercase;font-weight:bold;font-size:1.4em;flex:0 0 100%;order:10;text-align:center}#main-menu > *{display:block;margin:.5em 0;text-decoration:none;color:#000;padding:.3em 0;transition:70ms all}#main-menu > .mm-spacer{display:none}#main-menu > .main-menu-item.selected,#main-menu > .main-menu-item:hover{border-bottom:4px solid #61e294;margin-bottom:-4px}.menu-button{border:none;background:none;cursor:pointer}.menu-button img{vertical-align:middle}#main-menu .button1{margin:.2em 0;min-width:none}#home-link2{display:flex;align-items:center;justify-content:end}@media all and (min-width:1200px){#main-nav{height:var(--header-height);flex-wrap:nowrap;align-items:normal;position:static}#main-menu{display:flex;justify-content:space-between;align-items:baseline;position:static;flex-basis:auto;font-size:1.1em;gap:1.5em;flex:1 1 auto}#main-menu > *{flex:1 1 auto;margin:0;align-self:center}#main-menu > .mm-spacer{display:block;flex:10 1 50px}.menu-button{display:none}#home-link{max-width:none}#home-link2{order:-1;flex:0 0 auto}#main-menu .button1{margin:0;min-width:8em}}@media all and (max-width:1199px){#main-menu-checkbox:not(:checked) + #main-menu{display:none}}</style><div id="main-nav">
